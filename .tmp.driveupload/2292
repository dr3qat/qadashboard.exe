class TestValePresentePageExecutarFluxoCompletoValePresente:
    """Testes para o método executar_fluxo_completo_vale_presente."""

    @patch('pages.vale_presente_page.BasePage.__init__', return_value=None)
    @patch('pages.vale_presente_page.logger')
    @patch('pages.vale_presente_page.time')
    def test_executar_fluxo_completo_executa_todas_acoes(self, mock_time, mock_logger, mock_base_init):
        """
        Deve executar todas as ações do fluxo completo.
        """
        from pages.vale_presente_page import ValePresentePage

        # Arrange
        page = ValePresentePage.__new__(ValePresentePage)
        page.driver = MagicMock()
        page.navegar_para_vale_presente = MagicMock()
        page.selecionar_vendedor = MagicMock()
        page.obter_dados_resumo_vale_presente = MagicMock(return_value={
            "cliente": "CONSUMIDOR",
            "nome_vale": "VALE PRESENTE",
            "numero_vale": "VLP001",
            "valor": "R$ 100,00"
        })
        page.clicar_finalizar = MagicMock()
        page.selecionar_pagamento_dinheiro = MagicMock()
        page.clicar_avancar_pagamento = MagicMock()
        page.tratar_alerta_cashback = MagicMock()
        page.finalizar_pagamento = MagicMock()
        page.responder_impressao = MagicMock()
        page.venda_sucesso_exibida = MagicMock(return_value=True)
        page.concluir_venda = MagicMock()

        # Act
        dados = page.executar_fluxo_completo_vale_presente()

        # Assert
        page.navegar_para_vale_presente.assert_called_once()
        page.selecionar_vendedor.assert_called_once()
        page.obter_dados_resumo_vale_presente.assert_called_once()
        page.clicar_finalizar.assert_called_once()
        page.selecionar_pagamento_dinheiro.assert_called_once()
        page.clicar_avancar_pagamento.assert_called_once()
        page.tratar_alerta_cashback.assert_called_once()
        page.finalizar_pagamento.assert_called_once()
        page.responder_impressao.assert_called_once()
        page.venda_sucesso_exibida.assert_called_once()
        page.concluir_venda.assert_called_once()
        assert dados["cliente"] == "CONSUMIDOR"
