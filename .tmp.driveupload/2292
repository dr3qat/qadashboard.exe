class TestValePresentePageObterDadosResumoValePresente:
    """Testes para o método obter_dados_resumo_vale_presente."""

    @patch('pages.vale_presente_page.BasePage.__init__', return_value=None)
    @patch('pages.vale_presente_page.logger')
    def test_obter_dados_resumo_retorna_dict_com_dados(self, mock_logger, mock_base_init):
        """
        Deve retornar dicionário com todos os dados do vale presente.
        """
        from pages.vale_presente_page import ValePresentePage

        # Arrange
        page = ValePresentePage.__new__(ValePresentePage)
        page.driver = MagicMock()

        mock_cliente = MagicMock()
        mock_cliente.text = "CONSUMIDOR"
        mock_nome = MagicMock()
        mock_nome.text = "VALE PRESENTE USAFLEX"
        mock_numero = MagicMock()
        mock_numero.text = "VLP0000001"
        mock_valor = MagicMock()
        mock_valor.text = "R$ 100,00"

        page.encontrar_clicavel_por_id = MagicMock(side_effect=[
            mock_cliente, mock_nome, mock_numero, mock_valor
        ])

        # Act
        dados = page.obter_dados_resumo_vale_presente()

        # Assert
        assert dados == {
            "cliente": "CONSUMIDOR",
            "nome_vale": "VALE PRESENTE USAFLEX",
            "numero_vale": "VLP0000001",
            "valor": "R$ 100,00"
        }

    @patch('pages.vale_presente_page.BasePage.__init__', return_value=None)
    @patch('pages.vale_presente_page.logger')
    def test_obter_dados_resumo_lanca_erro_quando_campo_vazio(self, mock_logger, mock_base_init):
        """
        Deve lançar exceção quando algum campo está vazio.
        """
        from pages.vale_presente_page import ValePresentePage

        # Arrange
        page = ValePresentePage.__new__(ValePresentePage)
        page.driver = MagicMock()

        mock_cliente = MagicMock()
        mock_cliente.text = "CONSUMIDOR"
        mock_nome = MagicMock()
        mock_nome.text = "VALE PRESENTE"
        mock_numero = MagicMock()
        mock_numero.text = ""  # Vazio
        mock_valor = MagicMock()
        mock_valor.text = "R$ 100,00"

        page.encontrar_clicavel_por_id = MagicMock(side_effect=[
            mock_cliente, mock_nome, mock_numero, mock_valor
        ])

        # Act & Assert
        with pytest.raises(Exception, match="Um ou mais campos do resumo estão vazios"):
            page.obter_dados_resumo_vale_presente()


