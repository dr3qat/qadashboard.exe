"""
Venda Sucesso Page - Page Object para tela de sucesso da venda.
Gerencia todas as impressões disponíveis após finalizar uma venda.
"""
import time
from pages.base_page import BasePage
from config import logger, LogStyle
from test_data import test_data


class VendaSucessoPage(BasePage):
    """Page Object para tela de sucesso da venda com controle de impressões."""

    # ========== LOCATORS ==========

    # Botões da tela de sucesso
    BTN_CONFIRMAR_VENDA = "btn_confirmar_venda"
    BTN_IMPRESSAO_NFCE = "btn_impressao_nfce"
    BTN_NFE_PRINT = "btn_nfe_print"
    BTN_PRINT_CUPOM_TROCA = "btn_print_cupom_troca"

    # Diálogos
    BTN_DIALOG_SIM = "android:id/button1"
    BTN_DIALOG_NAO = "android:id/button2"
    BTN_OK_SUCESSO = "md_buttonDefaultPositive"

    # ========== MÉTODOS DE IMPRESSÃO ==========

    def imprimir_nfce(self, imprimir: bool = None):
        """
        Imprime NFC-E (Nota Fiscal do Consumidor Eletrônica) se configurado.

        Args:
            imprimir: Se None, usa a configuração global (test_data.PRINT_NFCE).
                     Se True/False, sobrescreve a configuração global.
        """
        if imprimir is None:
            imprimir = test_data.PRINT_NFCE

        if not imprimir:
            logger.info(f"   {LogStyle.SKIP} Impressão NFC-E desabilitada (config: {test_data.PRINT_NFCE})")
            return

        logger.info(f"{LogStyle.ACAO} Imprimindo NFC-E...")

        # Clica no botão de impressão NFC-E
        if self.clicar_se_existir(self.BTN_IMPRESSAO_NFCE, tempo_espera=5):
            logger.info(f"   {LogStyle.OK} Botão NFC-E clicado")

            # Responde SIM no diálogo de confirmação
            if self.clicar_se_existir(self.BTN_DIALOG_SIM, tempo_espera=10):
                logger.info(f"   {LogStyle.OK} Confirmação SIM enviada")
                time.sleep(2)
        else:
            logger.info(f"   {LogStyle.INFO} Botão NFC-E não encontrado (pode não estar disponível)")

    def imprimir_danfe(self, imprimir: bool = None):
        """
        Imprime DANFE via servidor (Documento Auxiliar NF-e) se configurado.

        Args:
            imprimir: Se None, usa a configuração global (test_data.PRINT_DANFE).
                     Se True/False, sobrescreve a configuração global.
        """
        if imprimir is None:
            imprimir = test_data.PRINT_DANFE

        if not imprimir:
            logger.info(f"   {LogStyle.SKIP} Impressão DANFE desabilitada (config: {test_data.PRINT_DANFE})")
            return

        logger.info(f"{LogStyle.ACAO} Imprimindo DANFE via servidor...")

        # Clica no botão de impressão DANFE
        if self.clicar_se_existir(self.BTN_NFE_PRINT, tempo_espera=5):
            logger.info(f"   {LogStyle.OK} Botão DANFE clicado")

            # Clica OK na mensagem de sucesso
            if self.clicar_se_existir(self.BTN_OK_SUCESSO, tempo_espera=10):
                logger.info(f"   {LogStyle.OK} Mensagem de sucesso confirmada")
                time.sleep(2)
        else:
            logger.info(f"   {LogStyle.INFO} Botão DANFE não encontrado (pode não estar disponível)")

    def imprimir_cupom_troca(self, imprimir: bool = None):
        """
        Imprime cupom de troca se configurado.

        Args:
            imprimir: Se None, usa a configuração global (test_data.PRINT_CUPOM_TROCA).
                     Se True/False, sobrescreve a configuração global.
        """
        if imprimir is None:
            imprimir = test_data.PRINT_CUPOM_TROCA

        if not imprimir:
            logger.info(f"   {LogStyle.SKIP} Impressão Cupom Troca desabilitada (config: {test_data.PRINT_CUPOM_TROCA})")
            return

        logger.info(f"{LogStyle.ACAO} Imprimindo cupom de troca...")

        # Clica no botão de impressão de cupom de troca
        if self.clicar_se_existir(self.BTN_PRINT_CUPOM_TROCA, tempo_espera=5):
            logger.info(f"   {LogStyle.OK} Botão Cupom Troca clicado")

            # Responde SIM no diálogo de confirmação
            if self.clicar_se_existir(self.BTN_DIALOG_SIM, tempo_espera=10):
                logger.info(f"   {LogStyle.OK} Confirmação SIM enviada")
                time.sleep(2)
        else:
            logger.info(f"   {LogStyle.INFO} Botão Cupom Troca não encontrado (pode não estar disponível)")

    def processar_todas_impressoes(self):
        """
        Processa todas as impressões opcionais conforme configuração global.
        Este método deve ser chamado na tela de sucesso da venda.

        IMPORTANTE: Se o sistema tiver parâmetro habilitado, o diálogo de cupom de troca
        pode aparecer ANTES desta tela. Nesse caso, ele deve ser respondido primeiro.

        Ordem de processamento (conforme XML da tela):
        1. IMPRIMIR NFC-E (btn_impressao_nfce)
        2. IMPRIMIR DANFE VIA SERVIDOR (btn_nfe_print)
        3. IMPRIMIR CUPOM DE TROCA (btn_print_cupom_troca)
        4. (ENVIAR EMAIL ignorado - não controlado pelo Dashboard)
        """
        logger.info(f"{LogStyle.secao('📋 PROCESSANDO IMPRESSÕES (ordem XML)')}")

        # 1. NFC-E (primeiro botão visível)
        self.imprimir_nfce()

        # 2. DANFE via Servidor (segundo botão)
        self.imprimir_danfe()

        # 3. Cupom de Troca (terceiro botão - se não foi perguntado antes)
        self.imprimir_cupom_troca()

        logger.info(f"{LogStyle.secao('📋 IMPRESSÕES PROCESSADAS ✅')}")

    def concluir_venda(self):
        """Clica no botão confirmar venda para retornar à tela inicial."""
        logger.info(f"{LogStyle.ACAO} Concluindo venda...")
        self.ver_e_clicar(self.BTN_CONFIRMAR_VENDA)
        time.sleep(2)

    # ========== VALIDAÇÕES ==========

    def tela_sucesso_exibida(self, timeout: int = 10) -> bool:
        """Verifica se a tela de sucesso está sendo exibida."""
        return self.texto_exibido("Venda realizada com sucesso!", timeout)

    def botao_nfce_disponivel(self, timeout: int = 3) -> bool:
        """Verifica se o botão de impressão NFC-E está disponível."""
        return self.elemento_existe(self.BTN_IMPRESSAO_NFCE, timeout)

    def botao_danfe_disponivel(self, timeout: int = 3) -> bool:
        """Verifica se o botão de impressão DANFE está disponível."""
        return self.elemento_existe(self.BTN_NFE_PRINT, timeout)

    def botao_cupom_troca_disponivel(self, timeout: int = 3) -> bool:
        """Verifica se o botão de impressão de cupom de troca está disponível."""
        return self.elemento_existe(self.BTN_PRINT_CUPOM_TROCA, timeout)
